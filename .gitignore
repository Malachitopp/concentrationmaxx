# Secrets — never commit
.env
.env.*
!.env.example
*.p8
*.p12
*.mobileprovision
*.cer

# Xcode (project is generated by XcodeGen in CI)
# XcodeGen also writes every target's Info.plist and .entitlements into ios/Generated
# from ios/project.yml, so project.yml stays the single source of truth.
ios/Generated/
*.xcodeproj
*.xcworkspace
xcuserdata/
DerivedData/
build/
*.xcarchive
*.ipa
*.dSYM
*.dSYM.zip

# Swift Package Manager
.build/
.swiftpm/
Package.resolved.bak

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
