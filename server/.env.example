# Copy to .env for local runs (`docker run --env-file .env ...`). Never commit the real .env.
# On a hosting provider, set these as environment variables / secrets instead.

# MongoDB connection string. For Atlas, paste the "Drivers" string and put the database
# name after the host, e.g. ...mongodb.net/concentrationmaxx?retryWrites=true&w=majority
# (if no database name is given, "concentrationmaxx" is used).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/concentrationmaxx?retryWrites=true&w=majority

# Secret used to sign login tokens (HS256). At least 32 characters of random text.
# Changing it logs every device out of the server (the on-device unlock keeps working).
JWT_SECRET=replace-with-at-least-32-random-characters

# Shared invite code that new accounts must enter. Give it only to your friends.
INVITE_CODE=replace-with-your-invite-code

# Optional. Port to listen on (most hosts set PORT themselves). Default 8080.
# PORT=8080

# Optional. Name of a header that your host sets to the real client IP, used for rate
# limiting behind a proxy, e.g. Fly-Client-IP, CF-Connecting-IP or X-Forwarded-For.
# Leave unset when the server is reached directly.
# CLIENT_IP_HEADER=X-Forwarded-For
